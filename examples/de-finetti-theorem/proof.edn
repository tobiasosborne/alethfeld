{:theorem
 {:id :theorem,
  :statement
  "Let $(X_n)_{n \\geq 1}$ be an infinite exchangeable sequence of random variables taking values in a compact convex subset $K$ of a finite-dimensional real vector space $V$. Then there exists a unique probability measure $\\mu$ on $\\mathcal{P}(K)$ (the space of probability measures on $K$) such that the joint distribution of $(X_1, \\ldots, X_n)$ equals $\\int_{\\mathcal{P}(K)} P^{\\otimes n} \\, d\\mu(P)$ for all $n \\geq 1$. Equivalently, the sequence has a conditional i.i.d. representation: $(X_n)$ are conditionally independent and identically distributed given the tail $\\sigma$-algebra $\\mathcal{T}$.",
  :content-hash "f1be4222fcdd31c0"},
 :obligations
 [{:node-id :1-clm008,
   :claim
   "Define the random probability measure $P_\\Theta = \\delta_\\Theta \\in \\mathcal{P}(K)$, the Dirac mass at the limiting mean $\\Theta$.",
   :context
   {:assumptions
    [{:id :1-ass001,
      :statement
      "Assume $(X_n)_{n \\geq 1}$ is an infinite exchangeable sequence of random variables taking values in the compact convex set $K \\subseteq V$."}],
    :scope []}}
  {:node-id :1-clm018,
   :claim
   "The set of exchangeable probability measures on $K^\\infty$ forms a Choquet simplex, with extreme points being the i.i.d. measures $\\delta_\\theta^{\\otimes \\infty}$ for $\\theta \\in K$.",
   :context
   {:assumptions
    [{:id :1-ass001,
      :statement
      "Assume $(X_n)_{n \\geq 1}$ is an infinite exchangeable sequence of random variables taking values in the compact convex set $K \\subseteq V$."}],
    :scope []}}
  {:node-id :1-clm019,
   :claim
   "By Choquet's theorem, any exchangeable measure has a unique representation as an integral over the extreme points, hence $\\mu = \\nu$.",
   :context
   {:assumptions
    [{:id :1-ass001,
      :statement
      "Assume $(X_n)_{n \\geq 1}$ is an infinite exchangeable sequence of random variables taking values in the compact convex set $K \\subseteq V$."}],
    :scope []}}
  {:node-id :1-clm020,
   :claim "Therefore the mixing measure $\\mu$ is unique.",
   :context
   {:assumptions
    [{:id :1-ass001,
      :statement
      "Assume $(X_n)_{n \\geq 1}$ is an infinite exchangeable sequence of random variables taking values in the compact convex set $K \\subseteq V$."}],
    :scope []}}],
