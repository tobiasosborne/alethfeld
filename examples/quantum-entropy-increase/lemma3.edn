    :revision-of nil},
   :depth 1,
   :dependencies #{}},
  :1-t3a002
  {:statement
   "$T I T^\\dagger = I$: Since $T$ is diagonal, $T \\cdot I \\cdot T^\\dagger = T T^\\dagger = I$ (T is unitary).",
   :taint :clean,
   :parent nil,
   :content-hash "4f439c2277dcab70",
   :display-order 2,
   :type :claim,
   :scope #{},
   :justification :algebraic-rewrite,
   :status :verified,
   :id :1-t3a002,
   :provenance
   {:created-at "2026-01-06T18:00:00Z",
    :created-by :prover,
    :round 1,
    :revision-of nil},
   :depth 1,
   :dependencies #{:1-t3a001}},
  :1-t3a003
  {:statement
   "$T Z T^\\dagger = Z$: Since both $T$ and $Z$ are diagonal, $T Z T^\\dagger = \\text{diag}(1, \\omega) \\cdot \\text{diag}(1, -1) \\cdot \\text{diag}(1, \\omega^*) = \\text{diag}(1, -\\omega\\omega^*) = \\text{diag}(1, -1) = Z$.",
   :taint :clean,
   :parent nil,
   :content-hash "bff97f1e0a9a5b51",
   :display-order 3,
   :type :claim,
   :scope #{},
   :justification :algebraic-rewrite,
   :status :verified,
   :id :1-t3a003,
   :provenance
   {:created-at "2026-01-06T18:00:00Z",
    :created-by :prover,
    :round 1,
    :revision-of nil},
   :depth 1,
   :dependencies #{:1-t3a001}},
  :1-t3a004
  {:statement
   "$T X T^\\dagger = \\frac{1}{\\sqrt{2}}(X + Y)$: Computing $T X T^\\dagger = \\begin{pmatrix} 1 & 0 \\\\ 0 & \\omega \\end{pmatrix} \\begin{pmatrix} 0 & 1 \\\\ 1 & 0 \\end{pmatrix} \\begin{pmatrix} 1 & 0 \\\\ 0 & \\omega^* \\end{pmatrix} = \\begin{pmatrix} 0 & \\omega^* \\\\ \\omega & 0 \\end{pmatrix}$. Since $\\omega = e^{i\\pi/4} = \\frac{1+i}{\\sqrt{2}}$ and $\\omega^* = \\frac{1-i}{\\sqrt{2}}$, we have $\\begin{pmatrix} 0 & \\omega^* \\\\ \\omega & 0 \\end{pmatrix} = \\frac{1}{\\sqrt{2}} \\begin{pmatrix} 0 & 1-i \\\\ 1+i & 0 \\end{pmatrix} = \\frac{1}{\\sqrt{2}} \\left( \\begin{pmatrix} 0 & 1 \\\\ 1 & 0 \\end{pmatrix} + \\begin{pmatrix} 0 & -i \\\\ i & 0 \\end{pmatrix} \\right) = \\frac{1}{\\sqrt{2}}(X + Y)$.",
   :taint :clean,
   :parent nil,
   :content-hash "6b7753ab83f25700",
   :display-order 4,
   :type :claim,
   :scope #{},
   :justification :algebraic-rewrite,
   :status :verified,
   :id :1-t3a004,
   :provenance
   {:created-at "2026-01-06T18:00:00Z",
    :created-by :prover,
    :round 1,
    :revision-of nil},
   :depth 1,
   :dependencies #{:1-t3a001}},
  :1-t3a005
  {:statement
   "$T Y T^\\dagger = \\frac{1}{\\sqrt{2}}(Y - X)$: Computing $T Y T^\\dagger = \\begin{pmatrix} 1 & 0 \\\\ 0 & \\omega \\end{pmatrix} \\begin{pmatrix} 0 & -i \\\\ i & 0 \\end{pmatrix} \\begin{pmatrix} 1 & 0 \\\\ 0 & \\omega^* \\end{pmatrix} = \\begin{pmatrix} 0 & -i\\omega^* \\\\ i\\omega & 0 \\end{pmatrix}$. Since $i\\omega = ie^{i\\pi/4} = e^{i\\pi/2}e^{i\\pi/4} = e^{i3\\pi/4} = \\frac{-1+i}{\\sqrt{2}}$ and $-i\\omega^* = -ie^{-i\\pi/4} = e^{-i3\\pi/4} = \\frac{-1-i}{\\sqrt{2}}$, we get $\\begin{pmatrix} 0 & \\frac{-1-i}{\\sqrt{2}} \\\\ \\frac{-1+i}{\\sqrt{2}} & 0 \\end{pmatrix} = \\frac{1}{\\sqrt{2}} \\left( \\begin{pmatrix} 0 & -i \\\\ i & 0 \\end{pmatrix} - \\begin{pmatrix} 0 & 1 \\\\ 1 & 0 \\end{pmatrix} \\right) = \\frac{1}{\\sqrt{2}}(Y - X)$.",
   :taint :clean,
