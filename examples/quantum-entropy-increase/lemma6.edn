{:theorem
 {:id :theorem,
  :statement
  "Let $\\pi$ be a probability distribution on a finite set $\\Omega$ with entropy $H(\\pi)$. For each $\\omega \\in \\Omega$, let $k_\\omega \\geq 1$. Define $\\pi'(\\omega, j) = \\frac{\\pi(\\omega)}{k_\\omega}$ on $\\Omega' = \\bigsqcup_\\omega \\{(\\omega, j) : j \\in [k_\\omega]\\}$. Then $H(\\pi') = H(\\pi) + \\sum_{\\omega} \\pi(\\omega) \\log_2 k_\\omega$.",
  :content-hash "bb81fcaa4a3a6dd0"},
 :obligations [],
 :archived-nodes {},
 :external-refs {},
 :nodes
 {:1-l6a001
  {:statement
   "Let $\\pi$ be a probability distribution on finite set $\\Omega$ with Shannon entropy $H(\\pi) = -\\sum_{\\omega \\in \\Omega} \\pi(\\omega) \\log_2 \\pi(\\omega)$ (with convention $0 \\log_2 0 = 0$).",
   :taint :clean,
   :parent nil,
   :content-hash "62a166dcbb693dea",
