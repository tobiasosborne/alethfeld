{:theorem
 {:id :theorem,
  :statement
  "Let $\\mathsf{C}\\subset V$ be a proper cone with $\\phi$ in the interior of $\\mathsf{C}^*$. If $v_{a|x} \\in \\mathsf{C}$ is a steering assemblage (with $\\sum_a v_{a|x} = v_*$ independent of $x$ and $\\phi(v_*) = 1$), then there exists a set of measurements $f_{a|x} \\in \\mathsf{C}^*$ (with $\\sum_a f_{a|x} = \\phi$) and a vector $w \\in \\mathsf{C} \\otimes_{\\max} \\mathsf{C}$ such that $v_{a|x} = (f_{a|x} \\otimes \\mathrm{id})(w)$.",
  :content-hash "8bb2bdbe5c227e21"},
 :obligations [],
 :archived-nodes {},
 :external-refs {},
 :nodes
 {:1-verw01
  {:statement
   "$w \\in \\mathsf{C} \\otimes_{\\max} \\mathsf{C}$, i.e., for all $f, g \\in \\mathsf{C}^*$: $(f \\otimes g)(w) = \\sum_a \\phi(v_{a|x_0}) \\cdot f(\\hat{v}_a) \\cdot g(\\hat{v}_a) \\geq 0$",
   :taint :clean,
   :content-hash "caba48fb026e1980",
   :display-order 7,
