 :nodes
 {:1-a1b2c3
  {:statement
   "Let $f: \\{0,1\\}^n \\to \\{+1,-1\\}$ be a Boolean function with Fourier expansion $f(x) = \\sum_{S \\subseteq [n]} \\hat{f}(S) \\chi_S(x)$ where $\\chi_S(x) = (-1)^{\\sum_{i \\in S} x_i}$.",
   :taint :clean,
