{:theorem
 {:id :theorem,
  :statement
  "For $f: \\{0,1\\}^n \\to \\{+1,-1\\}$, the diagonal observable $L_f = \\sum_{x} f(x)|x\\rangle\\langle x|$ has Pauli expansion $L_f = \\sum_{S \\subseteq [n]} \\hat{f}(S) Z_S$ where $Z_S = \\bigotimes_{i=1}^n P_i$ with $P_i = Z$ if $i \\in S$ and $P_i = I$ otherwise.",
  :content-hash "a7df331d93b65acf"},
 :obligations [],
