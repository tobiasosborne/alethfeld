    :round 1,
    :revision-of nil},
   :depth 1,
   :dependencies #{:1-t1a011 :1-t1a005}},
  :1-t1a011
  {:statement
   "**Part (i) Complete**: Since $H(L_f) = H(f)$ and $\\mathrm{Inf}(L_f) = \\mathrm{Inf}(f)$ (by Lemma 1), we have $H(\\tilde{L}_f) = H(L_f) + \\mathrm{Inf}(L_f) = H(f) + \\mathrm{Inf}(f)$.",
   :taint :clean,
   :parent nil,
